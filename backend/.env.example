# ── DATABASE ──────────────────────────────────
DATABASE_URL="postgresql://tbc_user:tbc_pass_123@localhost:5432/tbc_db"

# ── JWT ───────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ── SERVER ────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS ──────────────────────────────────────
FRONTEND_URL="http://localhost:3000"

# ── FILE UPLOAD ───────────────────────────────
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=5242880

# ── GOOGLE SIGN-IN ────────────────────────────
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# ── SMTP (transactional email) ────────────────
SMTP_HOST="smtp.yourprovider.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="portal@trillionbusinesscommunity.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_NAME="Trillion Business Community"
SMTP_FROM_EMAIL="portal@trillionbusinesscommunity.com"

# Admin address that receives new-signup notifications (leave blank to disable)
ADMIN_NOTIFY_EMAIL="admin@trillionbusinesscommunity.com"

# ── MULTILINGUAL / TRANSLATION ────────────────
# Which machine-translation provider translates dynamic, database-backed
# content (deal-room projects, events, feed posts). See MULTILINGUAL.md.
#
#   stub            default. NO network call, NO cost. Jobs are queued and
#                   recorded, nothing is translated, and the API serves English.
#                   The whole system works in this mode — static UI text is
#                   still fully translated, because that ships in the bundle.
#   libretranslate  free and self-hostable. Recommended if you want real
#                   translation of database content without a paid account.
#   google          Google Cloud Translation v2. PAID, per character.
#   deepl           DeepL. PAID (free tier available). Does NOT support Persian.
TRANSLATION_PROVIDER=stub

# LibreTranslate — run it yourself, no key and no billing relationship:
#   docker run -d -p 5050:5000 libretranslate/libretranslate \
#     --load-only en,it,ru,fa,ar
LIBRETRANSLATE_URL=http://localhost:5050
# LIBRETRANSLATE_API_KEY=

# Google Cloud Translation (only read when TRANSLATION_PROVIDER=google).
# Restrict the key to the Translation API. It never leaves the server.
# GOOGLE_TRANSLATE_API_KEY=

# DeepL (only read when TRANSLATION_PROVIDER=deepl).
# DEEPL_API_KEY=
# DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# ── Translation worker ────────────────────────
# The worker is an interval inside this API process and its queue is a
# Postgres table — there is no Redis and no separate process to run.
TRANSLATION_WORKER_INTERVAL_MS=15000
TRANSLATION_WORKER_BATCH=5
TRANSLATION_TIMEOUT_MS=20000
TRANSLATION_BACKOFF_BASE_MS=30000
TRANSLATION_STALE_LOCK_MS=300000
TRANSLATION_PRUNE_INTERVAL_MS=3600000

# ── Connect Now / Enquire Now ─────────────────────────────────────────────────
# Where a member's enquiry goes when the project or company it is about has no
# recipient configured on it. A per-target address, set by an admin in the
# project or company form, always wins over this.
DEFAULT_ENQUIRY_EMAIL=codehands12@gmail.com
