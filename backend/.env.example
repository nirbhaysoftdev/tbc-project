# ── DATABASE ──────────────────────────────────
DATABASE_URL="postgresql://tbc_user:tbc_pass_123@localhost:5432/tbc_db"

# ── JWT ───────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ── SERVER ────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS ──────────────────────────────────────
FRONTEND_URL="http://localhost:3000"

# ── FILE UPLOAD ───────────────────────────────
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=5242880

# ── GOOGLE SIGN-IN ────────────────────────────
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# ── SMTP (transactional email) ────────────────
SMTP_HOST="smtp.yourprovider.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="portal@trillionbusinesscommunity.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_NAME="Trillion Business Community"
SMTP_FROM_EMAIL="portal@trillionbusinesscommunity.com"

# Admin address that receives new-signup notifications (leave blank to disable)
ADMIN_NOTIFY_EMAIL="admin@trillionbusinesscommunity.com"
