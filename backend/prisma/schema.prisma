// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  MEMBER
  ADMIN
}

enum UserStatus {
  ACTIVE
  FROZEN
  PENDING
  REJECTED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum AccountType {
  PROFESSIONAL
  BUSINESS
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
}

enum TransactionCategory {
  INVESTMENT
  WITHDRAWAL
  PROFIT
  PROFIT_ADJUSTMENT
  CAPITAL_RETURN
  ADMIN_CREDIT
  ADMIN_DEBIT
}

enum WithdrawStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── WALLET INVESTMENT ENGINE ──────────────────────────────────────────────────
// The capital + monthly/one-time profit engine behind the member wallet. Capital
// may optionally be attached to a deal-room `Project`; a project-less investment
// is a permanently supported case, not a legacy carve-out.

enum WalletInvestmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
  RETURNED
}

enum InvestmentRequestStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum ProfitType {
  ONE_TIME_AMOUNT
  ONE_TIME_PERCENT
  MONTHLY_PERCENT
}

enum ProfitRecordType {
  ONE_TIME
  MONTHLY
}

enum PostType {
  DEAL
  NETWORK
  EVENT
  HIRING
  INSIGHT
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  FUNDED
  CLOSED
  CANCELLED
}

enum InvestmentStatus {
  PENDING
  CONFIRMED
  REFUNDED
}

// ─── CORE USER ────────────────────────────────────────────────────────────────

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String?
  role          Role           @default(MEMBER)
  profilePhoto  String?
  status        UserStatus     @default(PENDING)
  kycStatus     KycStatus      @default(NOT_SUBMITTED)
  walletEnabled Boolean        @default(false)
  accountType   AccountType?
  emailVerified Boolean        @default(false)
  googleId      String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Wallet (optional - not all community members have a wallet)
  wallet              Wallet?
  transactions        Transaction[]
  withdrawRequests    WithdrawRequest[]
  walletInvestments   WalletInvestment[]
  profitConfigs       ProfitConfig[]
  profitRecords       ProfitRecord[]

  // Community
  profile             Profile?
  membership          Membership?
  posts               Post[]
  comments            Comment[]
  likes               Like[]
  sentMessages        Message[]            @relation("SentMessages")
  receivedMessages    Message[]            @relation("ReceivedMessages")
  eventRegistrations  EventRegistration[]
  notifications       Notification[]

  // Deal Room
  projectsOwned       Project[]            @relation("ProjectOwner")
  investments         Investment[]
  investmentRequests  InvestmentRequest[]

  // MMS - KYC & KPI
  kycDocuments        KycDocument[]
  kpiLogs             UserKpiLog[]
  kpiSummary          UserKpiSummary?

  // Admin
  adminLogs           AdminLog[]           @relation("AdminLogs")
  auditedLogs         AdminLog[]           @relation("AuditedUser")

  // Activity feed
  activityActed       ActivityLog[]        @relation("ActivityActor")
  activityTargeted    ActivityLog[]        @relation("ActivityTarget")

  @@map("users")
}

// ─── PROFILE ──────────────────────────────────────────────────────────────────

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  bio             String?
  company         String?
  industry        String?
  country         String?
  city            String?
  phone           String?
  phoneCountry    String?  // ISO code, e.g. "IT"
  phoneDialCode   String?  // e.g. "+39"
  linkedIn        String?
  website         String?
  interests       String[]
  jobTitle        String?
  experienceYears Int?

  // Professional
  cvUrl           String?
  residentIdUrl   String?
  passportUrl     String?
  billingAddress  String?

  // Business
  tradeLicenseUrl String?
  vatNumber       String?
  businessAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ─── EMAIL OTP ────────────────────────────────────────────────────────────────

model EmailOtp {
  id         String   @id @default(uuid())
  email      String
  codeHash   String
  purpose    String   @default("SIGNUP") // SIGNUP | LOGIN | RESET
  attempts   Int      @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([email, purpose])
  @@map("email_otps")
}

// ─── MEMBERSHIP ───────────────────────────────────────────────────────────────

model Membership {
  id        String         @id @default(uuid())
  userId    String         @unique
  status    String         @default("ACTIVE") // ACTIVE, SUSPENDED, EXPIRED
  joinedAt  DateTime       @default(now())
  renewedAt DateTime?
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memberships")
}

// ─── WALLET (SALBANK) ─────────────────────────────────────────────────────────

// Balances here are a CACHE recomputed by walletService.syncWallet() - never
// write them from anywhere else.
//
// `investmentAmount` / `profitAmount` are the *manual opening-balance*
// component: capital and profit an admin set by hand with no project ledger
// behind them. Every balance a member actually sees is this opening balance
// plus the derived project ledger (WalletInvestment + ProfitRecord).
model Wallet {
  id                String   @id @default(uuid())
  userId            String   @unique
  investmentAmount  Float    @default(0)
  profitAmount      Float    @default(0)
  pendingWithdrawal Float    @default(0)
  withdrawnProfit   Float    @default(0)
  totalBalance      Float    @default(0)
  currency          String   @default("EUR")
  lastUpdated       DateTime @default(now()) @updatedAt
  frozen            Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Transaction {
  id           String               @id @default(uuid())
  userId       String
  type         TransactionType
  category     TransactionCategory?
  description  String
  amount       Float
  balanceAfter Float?
  status       TransactionStatus    @default(COMPLETED)
  reference    String               @unique @default(uuid())
  createdAt    DateTime             @default(now())

  // Project-aware investment/profit ledger fields (all optional - legacy manual
  // transactions and deal-room-unrelated rows leave these null).
  projectId      String?
  profitType     ProfitType?
  profitRate     Float?
  investmentId   String?
  profitRecordId String?
  createdBy      String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@map("transactions")
}

// A single capital allocation by a user, optionally into a deal-room Project.
// Capital is only "eligible" for monthly profit starting the 15th of the month
// AFTER the month it was invested in (see investmentEngine.js) - never prorated.
// Live capital is `amount - returnedAmount`, so an admin capital return can be
// partial without destroying the original record.
model WalletInvestment {
  id               String                 @id @default(uuid())
  userId           String
  projectId        String?
  requestId        String?                @unique
  amount           Float
  returnedAmount   Float                  @default(0)
  investedAt       DateTime
  status           WalletInvestmentStatus @default(ACTIVE)
  rejectionReason  String?
  createdBy        String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project?           @relation(fields: [projectId], references: [id])
  request InvestmentRequest? @relation(fields: [requestId], references: [id])

  @@index([userId, projectId])
  @@map("wallet_investments")
}

// A member's request to invest in a deal-room project. Creating one has NO
// financial effect whatsoever - the member pays offline, the admin confirms
// receipt and completes the request with the ACTUAL amount received, and only
// then is a WalletInvestment created.
model InvestmentRequest {
  id              String                  @id @default(uuid())
  userId          String
  projectId       String
  requestedAmount Float
  actualAmount    Float?
  message         String?
  status          InvestmentRequestStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project           @relation(fields: [projectId], references: [id])
  investment WalletInvestment?

  @@index([userId, status])
  @@index([status])
  @@map("investment_requests")
}

// The active monthly-profit % for a user+project. Rate changes insert a NEW
// row (effectiveFrom = now or an admin-chosen date) rather than mutating the
// old one, so historical ProfitRecords stay traceable to the rate that
// actually produced them.
model ProfitConfig {
  id               String     @id @default(uuid())
  userId           String
  projectId        String?
  profitType       ProfitType @default(MONTHLY_PERCENT)
  rate             Float      // percent, e.g. 2 = 2%
  monthlyProfitDay Int        @default(15)
  effectiveFrom    DateTime   @default(now())
  active           Boolean    @default(true)
  createdBy        String?
  createdAt        DateTime   @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@index([userId, projectId, active])
  @@map("profit_configs")
}

// One row per profit event (one-time or a single monthly cycle). `period` is
// a human-readable cycle key - "YYYY-MM-15" for monthly rows, or a unique
// "ONE_TIME-<uuid>" token for one-time rows.
//
// `scopeKey` is `projectId` or the literal "NO_PROJECT", and exists purely so
// the uniqueness guard also covers project-less profit: Postgres treats NULLs
// as distinct, so a unique index over a nullable projectId would let the
// monthly job double-pay the same project-less cycle.
model ProfitRecord {
  id                String           @id @default(uuid())
  userId            String
  projectId         String?
  scopeKey          String
  type              ProfitRecordType
  period            String
  capitalSnapshot   Float
  rate              Float?
  amount            Float
  createdBy         String?
  generatedAt       DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@unique([userId, scopeKey, period])
  @@map("profit_records")
}

model WithdrawRequest {
  id          String         @id @default(uuid())
  userId      String
  firstName   String
  lastName    String
  companyName String
  bankName    String
  iban        String
  swiftNumber String
  address     String
  amount      Float
  reason      String
  status      WithdrawStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdraw_requests")
}

// ─── COMMUNITY FEED ───────────────────────────────────────────────────────────

model Post {
  id          String   @id @default(uuid())
  authorId    String
  type        PostType @default(INSIGHT)
  title       String?
  content     String
  location    String?
  // Deal-specific
  dealAmount  Float?
  dealIRR     Float?
  dealSpots   Int?
  // Event-specific
  eventDate   DateTime?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]

  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("likes")
}

// ─── EVENTS ───────────────────────────────────────────────────────────────────

model Event {
  id           String   @id @default(uuid())
  title        String
  description  String?
  type         String   @default("NETWORKING") // WEBINAR, WORKSHOP, GALA, ROUNDTABLE, NETWORKING
  startDate    DateTime
  endDate      DateTime
  location     String?
  isOnline     Boolean  @default(false)
  maxAttendees Int?
  imageUrl     String?
  createdBy    String
  createdAt    DateTime @default(now())

  registrations EventRegistration[]

  @@map("events")
}

model EventRegistration {
  id           String   @id @default(uuid())
  eventId      String
  userId       String
  registeredAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_registrations")
}

// ─── MESSAGING ────────────────────────────────────────────────────────────────

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages",     fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // NEW_POST, NEW_MESSAGE, DEAL_UPDATE, EVENT_REMINDER, PROFIT_DISTRIBUTED
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── DEAL ROOM ────────────────────────────────────────────────────────────────

model Project {
  id               String        @id @default(uuid())
  ownerId          String
  title            String
  description      String
  category         String
  targetAmount     Float
  raisedAmount     Float         @default(0)
  minInvestmentPct Float         @default(5) // minimum % (e.g. 5%)
  shareType        String        @default("LIMITED") // LIMITED or TOTAL
  status           ProjectStatus @default(DRAFT)
  riskLevel        String        @default("MEDIUM") // LOW, MEDIUM, HIGH
  fundingDeadline  DateTime
  targetIRR        Float?
  location         String?
  imageUrl         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  owner       User              @relation("ProjectOwner", fields: [ownerId], references: [id])
  documents   ProjectDocument[]
  investments Investment[]
  milestones  Milestone[]

  // Wallet capital/profit ledger attached to this project
  walletInvestments  WalletInvestment[]
  investmentRequests InvestmentRequest[]
  profitConfigs      ProfitConfig[]
  profitRecords      ProfitRecord[]
  transactions       Transaction[]

  @@map("projects")
}

// Deal-room media: images, PDFs and video attached to a project.
//
// `fileUrl` is a path inside backend/storage, which is NOT behind the public
// /uploads static mount. Bytes are only ever served by the authenticated
// streaming endpoint (projectMediaController), and the path itself is never
// returned to a client.
model ProjectDocument {
  id         String   @id @default(uuid())
  projectId  String
  name       String
  fileUrl    String
  type       String   // PITCH_DECK, FINANCIALS, LEGAL, RISK_ASSESSMENT, OTHER
  kind       String   @default("PDF") // IMAGE | PDF | VIDEO - drives the viewer
  mimeType   String?
  sizeBytes  Int?
  uploadedBy String?
  uploadedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_documents")
}

model Investment {
  id              String           @id @default(uuid())
  projectId       String
  investorId      String
  amount          Float
  sharePercentage Float
  status          InvestmentStatus @default(PENDING)
  notes           String?
  investedAt      DateTime         @default(now())

  project  Project @relation(fields: [projectId], references: [id])
  investor User    @relation(fields: [investorId], references: [id])

  @@map("investments")
}

model Milestone {
  id          String    @id @default(uuid())
  projectId   String
  title       String
  description String?
  targetDate  DateTime
  amount      Float
  status      String    @default("PENDING") // PENDING, COMPLETED, MISSED
  completedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("milestones")
}

// ─── ADMIN LOGS ───────────────────────────────────────────────────────────────

model AdminLog {
  id        String   @id @default(uuid())
  adminId   String
  targetId  String?
  action    String
  details   Json?
  timestamp DateTime @default(now())

  admin      User  @relation("AdminLogs",   fields: [adminId],  references: [id])
  targetUser User? @relation("AuditedUser", fields: [targetId], references: [id])

  @@map("admin_logs")
}

// ─── SYSTEM ───────────────────────────────────────────────────────────────────

// Every notable thing that happens in the system lands here: emails sent,
// member requests and approvals, investment requests, profit, withdrawals.
// `type` is a free string (see services/activityLog.js ACTIVITY) so new kinds
// of activity need no migration. Actor/target names are denormalised so a log
// line stays readable after the user row is gone.
model ActivityLog {
  id          String   @id @default(uuid())
  type        String
  category    String
  title       String
  description String?
  actorId     String?
  actorName   String?
  targetId    String?
  targetName  String?
  amount      Float?
  status      String   @default("SUCCESS")
  metadata    Json?
  createdAt   DateTime @default(now())

  actor  User? @relation("ActivityActor",  fields: [actorId],  references: [id], onDelete: SetNull)
  target User? @relation("ActivityTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([category, createdAt])
  @@index([targetId, createdAt])
  @@map("activity_logs")
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

// ─── MMS - KYC DOCUMENTS ──────────────────────────────────────────────────────

model KycDocument {
  id           String   @id @default(uuid())
  userId       String
  documentType String   // id_proof | business_proof
  documentUrl  String
  status       String   @default("pending") // pending | approved | rejected
  uploadedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_documents")
}

// ─── MMS - KPI TRACKING ───────────────────────────────────────────────────────

model UserKpiLog {
  id         String   @id @default(uuid())
  userId     String
  actionType String   // login | investment | referral | event_participation
  score      Int
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_kpi_logs")
}

model UserKpiSummary {
  userId      String   @id
  totalScore  Int      @default(0)
  lastUpdated DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_kpi_summary")
}
