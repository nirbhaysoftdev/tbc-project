// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  MEMBER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  FROZEN
  PENDING
  REJECTED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum AccountType {
  PROFESSIONAL
  BUSINESS
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
}

enum TransactionCategory {
  INVESTMENT
  WITHDRAWAL
  PROFIT
  PROFIT_ADJUSTMENT
  CAPITAL_RETURN
  ADMIN_CREDIT
  ADMIN_DEBIT
}

enum WithdrawStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── WALLET INVESTMENT ENGINE ──────────────────────────────────────────────────
// The capital + monthly/one-time profit engine behind the member wallet. Capital
// may optionally be attached to a deal-room `Project`; a project-less investment
// is a permanently supported case, not a legacy carve-out.

enum WalletInvestmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
  RETURNED
}

enum InvestmentRequestStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum ProfitType {
  ONE_TIME_AMOUNT
  ONE_TIME_PERCENT
  MONTHLY_PERCENT
}

enum ProfitRecordType {
  ONE_TIME
  MONTHLY
}

enum PostType {
  DEAL
  NETWORK
  EVENT
  HIRING
  INSIGHT
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  FUNDED
  CLOSED
  CANCELLED
}

// Where a project sits in its OFFICIAL launch history, which is a different
// question from `ProjectStatus` (is it published?).
//
//   NEVER_LAUNCHED  no official launch has ever been recorded. Every new
//                   project starts here, as did every DRAFT and CANCELLED
//                   project when this module was migrated in.
//   PRE_FEATURE     the project was already published before this module
//                   existed, so it was "launched" in the informal sense but
//                   no launch date was ever recorded. The migration put every
//                   ACTIVE/FUNDED/CLOSED project here rather than inventing a
//                   date, and the admin panel asks for a decision: run an
//                   official launch, or classify it as previously launched.
//   LAUNCHED        an official launch is recorded. `launchedAt` is the launch
//                   timestamp, EXCEPT for a PRE_FEATURE project an admin
//                   classified as previously launched: there it stays null,
//                   because the real date is not known and fabricating one is
//                   worse than admitting it (requirement §8).
enum ProjectLaunchState {
  NEVER_LAUNCHED
  PRE_FEATURE
  LAUNCHED
}

// A project is launched ONCE, and after that the only way to communicate about
// it is a major update. There is deliberately no "re-announce": a plain
// reminder with nothing new to say is not a thing this portal sends, so the
// only post-launch announcement is one that has to explain what changed.
//
// PROMO_RESTART is in the same table as the two announcement types on purpose:
// §9 asks the project history to show promotional-period changes alongside the
// announcements, and a restart sends nothing, so it is an announcement row
// whose email state is NOT_APPLICABLE.
enum ProjectAnnouncementType {
  INITIAL_LAUNCH
  MAJOR_UPDATE
  PROMO_RESTART
}

// The roll-up of one announcement's recipient rows.
//
// There is deliberately no DELIVERED: SMTP tells us an address was ACCEPTED by
// the mail server, never that a human received it. `SENT` means accepted, and
// the UI says so in those words (§10 "report the most accurate status
// available rather than claiming confirmed delivery").
// How one announcement's audience was narrowed. ALL is the default and the
// only value any announcement written before recipient selection existed can
// have, which is exactly what it means.
enum AnnouncementAudienceMode {
  ALL
  INCLUDE
  EXCLUDE
}

enum AnnouncementEmailState {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
  NOT_APPLICABLE
}

// One recipient's state. The rows ARE the outbox: they are written in the same
// transaction as the announcement, so an announcement can never exist without
// its send list and a crash mid-send loses nothing.
enum AnnouncementRecipientStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  DEAD
}

// Delivery state of a Connect Now / Enquire Now message. A row is written
// BEFORE the email is attempted, so a failed send leaves evidence instead of
// vanishing - the enquiry is the record, the email is the delivery.
enum EnquiryStatus {
  PENDING
  SENT
  FAILED
}

enum CompanyStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InvestmentStatus {
  PENDING
  CONFIRMED
  REFUNDED
}

// ─── CORE USER ────────────────────────────────────────────────────────────────

model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  passwordHash  String?
  role          Role         @default(MEMBER)
  profilePhoto  String?
  status        UserStatus   @default(PENDING)
  kycStatus     KycStatus    @default(NOT_SUBMITTED)
  walletEnabled Boolean      @default(false)
  accountType   AccountType?
  emailVerified Boolean      @default(false)
  // Preferred UI language, validated against the allowlist in
  // services/i18n/languages.js before it is ever written. Null means "never
  // chosen", which is what lets browser detection still apply on a new device.
  // Nullable and additive on purpose: no existing row changes meaning.
  locale        String?
  googleId      String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Soft delete (super admin). A row with deletedAt set is invisible to every
  // member-facing query and cannot log in; the ledger keeps its references.
  // Purging the row outright is a separate, explicitly confirmed action.
  deletedAt   DateTime?
  deletedById String?

  // Wallet (optional - not all community members have a wallet)
  wallet            Wallet?
  transactions      Transaction[]
  withdrawRequests  WithdrawRequest[]
  walletInvestments WalletInvestment[]
  profitConfigs     ProfitConfig[]
  profitRecords     ProfitRecord[]

  // Community
  profile            Profile?
  membership         Membership?
  posts              Post[]
  comments           Comment[]
  likes              Like[]
  sentMessages       Message[]           @relation("SentMessages")
  receivedMessages   Message[]           @relation("ReceivedMessages")
  eventRegistrations EventRegistration[]
  notifications      Notification[]

  // Deal Room
  projectsOwned             Project[]                      @relation("ProjectOwner")
  projectsManaged           Project[]                      @relation("ProjectManager")
  projectsLaunched          Project[]                      @relation("ProjectLauncher")
  projectAnnouncements      ProjectAnnouncement[]          @relation("AnnouncementAdmin")
  projectAnnouncementEmails ProjectAnnouncementRecipient[]
  emailBroadcasts           EmailBroadcast[]               @relation("BroadcastAdmin")
  emailBroadcastRecipients  EmailBroadcastRecipient[]
  companiesCreated          Company[]                      @relation("CompanyCreator")
  enquiries                 Enquiry[]                      @relation("MemberEnquiries")
  investments               Investment[]
  investmentRequests        InvestmentRequest[]

  // MMS - KYC & KPI
  kycDocuments KycDocument[]
  kpiLogs      UserKpiLog[]
  kpiSummary   UserKpiSummary?

  // Admin
  adminLogs   AdminLog[] @relation("AdminLogs")
  auditedLogs AdminLog[] @relation("AuditedUser")

  // Activity feed
  activityActed    ActivityLog[] @relation("ActivityActor")
  activityTargeted ActivityLog[] @relation("ActivityTarget")

  // Machine access
  apiKeysCreated ApiKey[] @relation("ApiKeysCreated")
  apiKeysRevoked ApiKey[] @relation("ApiKeysRevoked")

  @@index([deletedAt])
  @@map("users")
  analyticsSessions AnalyticsSession[] @relation("AnalyticsSessionUser")
  analyticsEvents   AnalyticsEvent[]   @relation("AnalyticsEventUser")
}

// ─── PROFILE ──────────────────────────────────────────────────────────────────

model Profile {
  id              String   @id @default(uuid())
  userId          String   @unique
  bio             String?
  company         String?
  industry        String?
  country         String?
  city            String?
  phone           String?
  phoneCountry    String? // ISO code, e.g. "IT"
  phoneDialCode   String? // e.g. "+39"
  linkedIn        String?
  website         String?
  interests       String[]
  jobTitle        String?
  experienceYears Int?

  // Professional
  cvUrl          String?
  residentIdUrl  String?
  passportUrl    String?
  billingAddress String?

  // Business
  tradeLicenseUrl String?
  vatNumber       String?
  businessAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ─── EMAIL OTP ────────────────────────────────────────────────────────────────

model EmailOtp {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  purpose    String    @default("SIGNUP") // SIGNUP | LOGIN | RESET
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
  @@map("email_otps")
}

// ─── MEMBERSHIP ───────────────────────────────────────────────────────────────

model Membership {
  id        String    @id @default(uuid())
  userId    String    @unique
  status    String    @default("ACTIVE") // ACTIVE, SUSPENDED, EXPIRED
  joinedAt  DateTime  @default(now())
  renewedAt DateTime?
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memberships")
}

// ─── WALLET (SALBANK) ─────────────────────────────────────────────────────────

// Balances here are a CACHE recomputed by walletService.syncWallet() - never
// write them from anywhere else.
//
// `investmentAmount` / `profitAmount` are the *manual opening-balance*
// component: capital and profit an admin set by hand with no project ledger
// behind them. Every balance a member actually sees is this opening balance
// plus the derived project ledger (WalletInvestment + ProfitRecord).
model Wallet {
  id                String   @id @default(uuid())
  userId            String   @unique
  investmentAmount  Float    @default(0)
  profitAmount      Float    @default(0)
  pendingWithdrawal Float    @default(0)
  withdrawnProfit   Float    @default(0)
  totalBalance      Float    @default(0)
  currency          String   @default("EUR")
  lastUpdated       DateTime @default(now()) @updatedAt
  frozen            Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Transaction {
  id           String               @id @default(uuid())
  userId       String
  type         TransactionType
  category     TransactionCategory?
  description  String
  amount       Float
  balanceAfter Float?
  status       TransactionStatus    @default(COMPLETED)
  reference    String               @unique @default(uuid())
  createdAt    DateTime             @default(now())

  // Project-aware investment/profit ledger fields (all optional - legacy manual
  // transactions and deal-room-unrelated rows leave these null).
  projectId      String?
  profitType     ProfitType?
  profitRate     Float?
  investmentId   String?
  profitRecordId String?
  createdBy      String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@map("transactions")
}

// A single capital allocation by a user, optionally into a deal-room Project.
// Capital is only "eligible" for monthly profit starting the 15th of the month
// AFTER the month it was invested in (see investmentEngine.js) - never prorated.
// Live capital is `amount - returnedAmount`, so an admin capital return can be
// partial without destroying the original record.
model WalletInvestment {
  id              String                 @id @default(uuid())
  userId          String
  projectId       String?
  requestId       String?                @unique
  amount          Float
  returnedAmount  Float                  @default(0)
  investedAt      DateTime
  status          WalletInvestmentStatus @default(ACTIVE)
  rejectionReason String?
  createdBy       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project?           @relation(fields: [projectId], references: [id])
  request InvestmentRequest? @relation(fields: [requestId], references: [id])

  @@index([userId, projectId])
  @@map("wallet_investments")
}

// A member's request to invest in a deal-room project. Creating one has NO
// financial effect whatsoever - the member pays offline, the admin confirms
// receipt and completes the request with the ACTUAL amount received, and only
// then is a WalletInvestment created.
model InvestmentRequest {
  id              String                  @id @default(uuid())
  userId          String
  projectId       String
  requestedAmount Float
  actualAmount    Float?
  message         String?
  status          InvestmentRequestStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project           @relation(fields: [projectId], references: [id])
  investment WalletInvestment?

  @@index([userId, status])
  @@index([status])
  @@map("investment_requests")
}

// The active monthly-profit % for a user+project. Rate changes insert a NEW
// row (effectiveFrom = now or an admin-chosen date) rather than mutating the
// old one, so historical ProfitRecords stay traceable to the rate that
// actually produced them.
model ProfitConfig {
  id               String     @id @default(uuid())
  userId           String
  projectId        String?
  profitType       ProfitType @default(MONTHLY_PERCENT)
  rate             Float // percent, e.g. 2 = 2%
  monthlyProfitDay Int        @default(15)
  effectiveFrom    DateTime   @default(now())
  active           Boolean    @default(true)
  createdBy        String?
  createdAt        DateTime   @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@index([userId, projectId, active])
  @@map("profit_configs")
}

// One row per profit event (one-time or a single monthly cycle). `period` is
// a human-readable cycle key - "YYYY-MM-15" for monthly rows, or a unique
// "ONE_TIME-<uuid>" token for one-time rows.
//
// `scopeKey` is `projectId` or the literal "NO_PROJECT", and exists purely so
// the uniqueness guard also covers project-less profit: Postgres treats NULLs
// as distinct, so a unique index over a nullable projectId would let the
// monthly job double-pay the same project-less cycle.
model ProfitRecord {
  id              String           @id @default(uuid())
  userId          String
  projectId       String?
  scopeKey        String
  type            ProfitRecordType
  period          String
  capitalSnapshot Float
  rate            Float?
  amount          Float
  createdBy       String?
  generatedAt     DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@unique([userId, scopeKey, period])
  @@map("profit_records")
}

model WithdrawRequest {
  id          String         @id @default(uuid())
  userId      String
  firstName   String
  lastName    String
  companyName String
  bankName    String
  iban        String
  swiftNumber String
  address     String
  amount      Float
  reason      String
  status      WithdrawStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdraw_requests")
}

// ─── COMMUNITY FEED ───────────────────────────────────────────────────────────

model Post {
  id         String    @id @default(uuid())
  authorId   String
  type       PostType  @default(INSIGHT)
  title      String?
  content    String
  location   String?
  // Deal-specific
  dealAmount Float?
  dealIRR    Float?
  dealSpots  Int?
  // Event-specific
  eventDate  DateTime?
  imageUrl   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]

  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("likes")
}

// ─── EVENTS ───────────────────────────────────────────────────────────────────

model Event {
  id           String   @id @default(uuid())
  title        String
  description  String?
  type         String   @default("NETWORKING") // WEBINAR, WORKSHOP, GALA, ROUNDTABLE, NETWORKING
  startDate    DateTime
  endDate      DateTime
  location     String?
  isOnline     Boolean  @default(false)
  maxAttendees Int?
  imageUrl     String?
  createdBy    String
  createdAt    DateTime @default(now())

  registrations EventRegistration[]

  @@map("events")
}

model EventRegistration {
  id           String   @id @default(uuid())
  eventId      String
  userId       String
  registeredAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_registrations")
}

// ─── MESSAGING ────────────────────────────────────────────────────────────────

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String // NEW_POST, NEW_MESSAGE, DEAL_UPDATE, EVENT_REMINDER, PROFIT_DISTRIBUTED
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── DEAL ROOM ────────────────────────────────────────────────────────────────

model Project {
  id               String        @id @default(uuid())
  ownerId          String
  title            String
  description      String
  category         String
  targetAmount     Float
  raisedAmount     Float         @default(0)
  minInvestmentPct Float         @default(5) // minimum % (e.g. 5%)
  shareType        String        @default("LIMITED") // LIMITED or TOTAL
  status           ProjectStatus @default(DRAFT)
  riskLevel        String        @default("MEDIUM") // LOW, MEDIUM, HIGH
  fundingDeadline  DateTime
  targetIRR        Float?
  location         String?
  imageUrl         String?
  // ── Project showcase module ────────────────────────────────────────────────
  // Everything below is additive and nullable: a deal-room project created
  // before this module existed keeps working with all of it null.
  //
  // `valuation` is the headline figure the showcase displays and is ALWAYS in
  // euros. It is deliberately separate from `targetAmount`, which is the
  // funding ask the wallet ledger prices investments against - a project can
  // be worth 4M and be raising 400k.
  valuation        Float?
  // What the project is, as rich text from the WYSIWYG editor. Sanitised
  // server-side on every write (services/richText.js); never trusted as it
  // arrives, because it is rendered with dangerouslySetInnerHTML.
  detailsHtml      String?
  // When the project itself was established - not when this row was created.
  establishedAt    DateTime?
  // The ProjectDocument chosen as the banner. A plain column rather than a
  // relation: the document cascades on delete and a dangling id simply falls
  // back to the first image, which is what a missing banner should do anyway.
  bannerDocId      String?
  primaryObjective String?
  managerId        String?
  // People attached to the project, stored as [{ id, name, role? }]. Members
  // are snapshotted by name on save so a removed account does not blank the
  // showcase; `id` still links back to the member where one exists.
  teamMembers      Json?
  investors        Json?
  partners         Json?
  clients          Json?
  url              String?
  contact          String?

  // ── Official launch & promotion ────────────────────────────────────────────
  // Additive and nullable: a project that predates this module keeps working
  // with all of it null, and nothing here is written by an ordinary edit.
  //
  // `launchedAt` is server time at the moment an admin confirmed the launch.
  // It is written ONCE and never touched again - not by an edit, not by a
  // re-announcement, not by a major update, not by a promotional restart.
  launchedAt         DateTime?
  launchedById       String?
  launchState        ProjectLaunchState @default(NEVER_LAUNCHED)
  // When the "Newly Launched" badge stops showing. The badge is derived from
  // this column on every read, so it expires on its own with no scheduled job
  // to go wrong, and a server clock is the only authority involved.
  newlyLaunchedUntil DateTime?
  // The CURRENT promotional window, which is the original launch window until
  // an admin deliberately restarts it. Kept separate from `launchedAt` so a
  // restart never rewrites launch history (§7).
  promoStartedAt     DateTime?
  promoRestartCount  Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User                  @relation("ProjectOwner", fields: [ownerId], references: [id])
  manager       User?                 @relation("ProjectManager", fields: [managerId], references: [id])
  launchedBy    User?                 @relation("ProjectLauncher", fields: [launchedById], references: [id])
  announcements ProjectAnnouncement[]
  documents     ProjectDocument[]
  investments   Investment[]
  milestones    Milestone[]

  // Wallet capital/profit ledger attached to this project
  walletInvestments  WalletInvestment[]
  investmentRequests InvestmentRequest[]
  profitConfigs      ProfitConfig[]
  profitRecords      ProfitRecord[]
  transactions       Transaction[]
  enquiries          Enquiry[]

  @@index([ownerId])
  @@index([managerId])
  @@index([category])
  @@index([status])
  @@index([launchState])
  @@index([newlyLaunchedUntil])
  @@map("projects")
}

// Deal-room media: images, PDFs and video attached to a project.
//
// `fileUrl` is a path inside backend/storage, which is NOT behind the public
// /uploads static mount. Bytes are only ever served by the authenticated
// streaming endpoint (projectMediaController), and the path itself is never
// returned to a client.
model ProjectDocument {
  id         String   @id @default(uuid())
  projectId  String
  name       String
  fileUrl    String
  type       String // PITCH_DECK, FINANCIALS, LEGAL, RISK_ASSESSMENT, OTHER
  kind       String   @default("PDF") // IMAGE | PDF | VIDEO - drives the viewer
  mimeType   String?
  sizeBytes  Int?
  uploadedBy String?
  uploadedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_documents")
}

// ─── PROJECT LAUNCH & ANNOUNCEMENTS ───────────────────────────────────────────
// The announcement history for one project: its official launch, every major
// update announced since, and every promotional-period restart. §9 asks for
// one history an admin can read, so all three live here and the page renders
// them as one timeline.
//
// IDEMPOTENCY. `idempotencyKey` is unique, and every write path creates the
// row with one. A retried HTTP request therefore collides on the index and is
// answered with the announcement that already exists, instead of mailing the
// whole community twice. The keys are:
//
//   INITIAL_LAUNCH   `launch:<projectId>`  - deterministic, so a project can
//                    only ever have one initial launch, even from two admins
//                    clicking at the same moment.
//   MAJOR_UPDATE     a key the admin's browser generates once per composer
//                    session and reuses when a failed request is retried. A
//                    DELIBERATE second update is a new composer session and so
//                    a new key, which is what tells a retry apart from a new
//                    announcement.
//   PROMO_RESTART    `promo:<projectId>:<n>` where n is the restart count.
model ProjectAnnouncement {
  id             String                  @id @default(uuid())
  projectId      String
  type           ProjectAnnouncementType
  idempotencyKey String                  @unique

  // What was actually sent. Stored rather than re-derived, so the history
  // shows the words the community received even after the project is edited.
  title          String
  message        String
  // Major updates only: the optional longer explanation and the category.
  detail         String?
  updateCategory String?

  // Which audience this went to. One value today - every active member - but
  // stored per announcement so a narrower audience later does not make the
  // existing history ambiguous. See services/projectLaunch.js AUDIENCES.
  audience String @default("ALL_ACTIVE_MEMBERS")

  // How the audience above was narrowed, per announcement.
  //
  // ALL is the audience as it stood; INCLUDE means only `audienceUserIds` were
  // written to the outbox; EXCLUDE means the audience minus them. Stored
  // rather than derived because the member list moves: "412 of 530" has to
  // stay readable months later, when both figures would compute differently.
  audienceMode    AnnouncementAudienceMode @default(ALL)
  // The members the admin ticked. Ids, not addresses — the addresses that were
  // actually mailed are snapshotted on the recipient rows, and an exclusion
  // has no recipient row to carry it.
  audienceUserIds String[]                 @default([])
  // The size of the audience BEFORE the narrowing was applied.
  audienceSize    Int                      @default(0)

  adminId   String?
  // Denormalised so a history line stays readable after the admin's account is
  // gone, exactly as ActivityLog does it.
  adminName String?

  // The community announcement this created: a feed Post. Null until it is
  // made, and the one place the retry path looks to decide whether the
  // announcement was already published.
  postId        String?
  // How many per-member Notification rows were written.
  notifiedCount Int     @default(0)

  recipientCount Int                    @default(0)
  emailState     AnnouncementEmailState @default(PENDING)

  // Promotional-period change carried by this row. Set on PROMO_RESTART, and
  // also on INITIAL_LAUNCH, which starts the first period. Never set by a
  // major update - announcing a change may not touch the badge (§6).
  promoStartedAt DateTime?
  promoEndsAt    DateTime?
  promoReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  admin      User?                          @relation("AnnouncementAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  recipients ProjectAnnouncementRecipient[]

  @@index([projectId, createdAt])
  @@map("project_announcements")
}

// One announcement, one recipient, one row - the recipient-level delivery
// record §10 asks for, and the queue the worker consumes.
//
// Written inside the same transaction as the announcement (the transactional
// outbox pattern), so there is no window where an announcement exists with no
// send list, and none where mail is queued for an announcement that was rolled
// back. The worker claims rows with a conditional UPDATE, exactly as the
// translation worker does, so two API processes behind pm2 cannot send the same
// email twice. See services/announcementWorker.js.
model ProjectAnnouncementRecipient {
  id             String  @id @default(uuid())
  announcementId String
  userId         String?
  // Snapshotted: the address the mail was actually queued for. A member who
  // later changes their email does not rewrite what was sent.
  email          String
  name           String?

  status      AnnouncementRecipientStatus @default(QUEUED)
  attempts    Int                         @default(0)
  maxAttempts Int                         @default(5)
  lastError   String?
  // Backoff deadline: the worker only claims rows whose runAfter has passed.
  runAfter    DateTime                    @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  // When the mail server ACCEPTED it. Not a delivery confirmation - SMTP does
  // not provide one, and the UI never claims otherwise.
  sentAt      DateTime?
  messageId   String?

  announcement ProjectAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  // The guarantee that a retry cannot mail the same person twice for the same
  // announcement, whatever goes wrong above it.
  @@unique([announcementId, email])
  @@index([status, runAfter])
  @@map("project_announcement_recipients")
}

// ─── EMAIL BROADCASTS ─────────────────────────────────────────────────────────
// The admin-written broadcast email: a free-form message, a select/exclude
// recipient choice, and a send. It is the same design as ProjectAnnouncement /
// ProjectAnnouncementRecipient above, deliberately reused rather than
// generalised into one shared model - a broadcast has no project, and bolting
// an optional projectId onto the announcement tables would make every existing
// query there handle a case that was never possible before. See
// services/emailBroadcast.js and services/emailBroadcastWorker.js.
enum BroadcastAudienceMode {
  ALL
  INCLUDE
  EXCLUDE
}

enum BroadcastEmailState {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum BroadcastRecipientStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  DEAD
}

model EmailBroadcast {
  id             String @id @default(uuid())
  // Supplied by the composer and kept for the life of that compose, so a
  // retried request is recognised rather than sent twice - same role as
  // ProjectAnnouncement.idempotencyKey.
  idempotencyKey String @unique

  subject  String
  heading  String
  intro    String?
  bodyText String
  ctaLabel String?
  ctaUrl   String?

  // One audience today: ACTIVE, non-deleted users. Stored as a string, not
  // hardcoded, for the same reason projectLaunch.js stores it - so a narrower
  // audience added later does not make this history ambiguous.
  audience        String                @default("ALL_ACTIVE_MEMBERS")
  audienceMode    BroadcastAudienceMode @default(ALL)
  audienceUserIds String[]              @default([])
  audienceSize    Int                   @default(0)

  adminId   String?
  adminName String?

  recipientCount Int                 @default(0)
  emailState     BroadcastEmailState @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin      User?                     @relation("BroadcastAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  recipients EmailBroadcastRecipient[]

  @@index([createdAt])
  @@map("email_broadcasts")
}

// One broadcast, one recipient, one row - same transactional-outbox shape as
// ProjectAnnouncementRecipient, consumed by services/emailBroadcastWorker.js.
model EmailBroadcastRecipient {
  id          String  @id @default(uuid())
  broadcastId String
  userId      String?
  // Snapshotted at send time, like ProjectAnnouncementRecipient.email.
  email       String
  name        String?

  status      BroadcastRecipientStatus @default(QUEUED)
  attempts    Int                      @default(0)
  maxAttempts Int                      @default(5)
  lastError   String?
  runAfter    DateTime                 @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  sentAt      DateTime?
  messageId   String?

  broadcast EmailBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([broadcastId, email])
  @@index([status, runAfter])
  @@map("email_broadcast_recipients")
}

// ─── COMPANY PROFILES ─────────────────────────────────────────────────────────
// The company profile module: the directory of member companies, their
// profiles, media and documents. It deliberately mirrors `Project` field for
// field where the two mean the same thing, so the two modules can share the
// rich-text sanitiser, the people normaliser and the whole frontend design
// system rather than growing two of each.
//
// What is different, and why:
//   - a company has MANY owners and MANY locations, so those are arrays, not
//     single columns;
//   - `ownerIds` is a scalar list beside the `owners` JSON. The JSON is what
//     the profile displays (it also holds owners who are not portal members);
//     `ownerIds` is what the listing's owner filter queries, because Postgres
//     can index and `has`-match a text array, while filtering inside a JSON
//     array of objects cannot be done reliably;
//   - presentation videos can be an upload OR an embedded link, so there is a
//     `videoLinks` column as well as video documents.
model Company {
  id       String        @id @default(uuid())
  name     String
  category String
  status   CompanyStatus @default(ACTIVE)

  // Card text. `description` is the short line the listing shows;
  // `detailsHtml` is the WYSIWYG body, sanitised on write
  // (services/richText.js) because it is rendered as HTML.
  description String?
  detailsHtml String?

  // Always euros, like every other figure in the portal.
  valuation     Float?
  establishedAt DateTime?

  // Logo and banner are CompanyDocument rows, referenced by id rather than by
  // relation: a document cascades on delete, and a dangling id falls back to
  // "no logo", which is the right behaviour for a deleted image.
  logoDocId   String?
  bannerDocId String?

  // Owners: the display list, and the member ids the filter queries.
  owners   Json?
  ownerIds String[] @default([])

  // A company can operate in several places; the listing filters on `has`.
  locations String[] @default([])

  teamMembers Json?

  websiteUrl    String?
  contactPerson String?
  // contactEmail and contactPhone are stored for administration only. They are
  // stripped from every member-facing payload - members reach a company
  // through "Connect Now", not through a published address.
  contactEmail  String?
  contactPhone  String?

  // Embedded presentation videos: [{ url, title }]. Only YouTube and Vimeo
  // URLs are accepted, normalised to their embed form on write - an arbitrary
  // URL in an iframe is someone else's page running inside the portal.
  videoLinks Json?

  // Who created the profile. Not "the owner": ownership is the list above.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?             @relation("CompanyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  documents CompanyDocument[]
  enquiries Enquiry[]

  @@index([category])
  @@index([status])
  @@index([createdById])
  // GIN, because these are scalar lists queried with `has` — that is what makes
  // the listing's owner and location filters index scans rather than a scan of
  // every row. Declared here as well as in the migration so `migrate diff`
  // reports no drift; without them Prisma would plan to drop both indexes.
  @@index([ownerIds], type: Gin)
  @@index([locations], type: Gin)
  @@map("companies")
}

// Media on a company profile. Same arrangement as ProjectDocument: the stored
// path never leaves the server and the bytes are only reachable through a
// short-lived, per-document ticket (companyMediaController.js).
model CompanyDocument {
  id         String   @id @default(uuid())
  companyId  String
  name       String
  fileUrl    String // basename inside storage/company-media, never sent out
  // Which viewer the client opens: IMAGE | PDF | DOC | VIDEO.
  kind       String   @default("PDF")
  // What the file is FOR: LOGO | BANNER | GALLERY | DOCUMENT | VIDEO | OTHER.
  // Separate from `kind` because a logo and a gallery photo are both images.
  purpose    String   @default("DOCUMENT")
  mimeType   String?
  sizeBytes  Int?
  uploadedBy String?
  uploadedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, purpose])
  @@map("company_documents")
}

// ─── CONNECT NOW / ENQUIRE NOW ────────────────────────────────────────────────
// A member's enquiry about a project or a company.
//
// This table is the record of the enquiry; the email is only its delivery. The
// row is written first and updated with the outcome, so a message that failed
// to send is still recoverable rather than lost in a log line.
//
// `memberId` is taken from the session on the server and never from the
// request body — the submitted name and email fields are read-only in the UI,
// which is a convenience, not a guarantee.
//
// Exactly one of projectId / companyId is set. A CHECK constraint enforces
// that in the database rather than trusting every future caller.
model Enquiry {
  id             String        @id @default(uuid())
  memberId       String
  projectId      String?
  companyId      String?
  // The project or company name as it was when the enquiry was sent, so the
  // record still reads correctly after a rename or a deletion.
  subjectName    String
  message        String
  // The address the enquiry actually went to, resolved at send time. Stored
  // because the configured recipient can change afterwards and this is the
  // audit trail of where the message went.
  recipientEmail String
  status         EnquiryStatus @default(PENDING)
  error          String?
  createdAt      DateTime      @default(now())
  sentAt         DateTime?

  member  User     @relation("MemberEnquiries", fields: [memberId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([memberId, createdAt])
  @@index([projectId])
  @@index([companyId])
  @@index([status])
  @@map("enquiries")
}

model Investment {
  id              String           @id @default(uuid())
  projectId       String
  investorId      String
  amount          Float
  sharePercentage Float
  status          InvestmentStatus @default(PENDING)
  notes           String?
  investedAt      DateTime         @default(now())

  project  Project @relation(fields: [projectId], references: [id])
  investor User    @relation(fields: [investorId], references: [id])

  @@map("investments")
}

model Milestone {
  id          String    @id @default(uuid())
  projectId   String
  title       String
  description String?
  targetDate  DateTime
  amount      Float
  status      String    @default("PENDING") // PENDING, COMPLETED, MISSED
  completedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("milestones")
}

// ─── ADMIN LOGS ───────────────────────────────────────────────────────────────

model AdminLog {
  id        String   @id @default(uuid())
  adminId   String
  targetId  String?
  action    String
  details   Json?
  timestamp DateTime @default(now())

  admin      User  @relation("AdminLogs", fields: [adminId], references: [id])
  targetUser User? @relation("AuditedUser", fields: [targetId], references: [id])

  @@map("admin_logs")
}

// ─── SYSTEM ───────────────────────────────────────────────────────────────────

// Every notable thing that happens in the system lands here: emails sent,
// member requests and approvals, investment requests, profit, withdrawals.
// `type` is a free string (see services/activityLog.js ACTIVITY) so new kinds
// of activity need no migration. Actor/target names are denormalised so a log
// line stays readable after the user row is gone.
model ActivityLog {
  id          String   @id @default(uuid())
  type        String
  category    String
  title       String
  description String?
  actorId     String?
  actorName   String?
  targetId    String?
  targetName  String?
  amount      Float?
  status      String   @default("SUCCESS")
  metadata    Json?
  createdAt   DateTime @default(now())

  actor  User? @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  target User? @relation("ActivityTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([category, createdAt])
  @@index([targetId, createdAt])
  @@map("activity_logs")
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

// ─── MMS - KYC DOCUMENTS ──────────────────────────────────────────────────────

model KycDocument {
  id           String   @id @default(uuid())
  userId       String
  documentType String // id_proof | business_proof
  documentUrl  String
  status       String   @default("pending") // pending | approved | rejected
  uploadedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("kyc_documents")
}

// ─── MMS - KPI TRACKING ───────────────────────────────────────────────────────

model UserKpiLog {
  id         String   @id @default(uuid())
  userId     String
  actionType String // login | investment | referral | event_participation
  score      Int
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_kpi_logs")
}

model UserKpiSummary {
  userId      String   @id
  totalScore  Int      @default(0)
  lastUpdated DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_kpi_summary")
}

// ─── TRANSLATIONS ─────────────────────────────────────────────────────────────
//
// English stays the single authoritative copy of every business record. None of
// the models above gain a per-language column and no record is duplicated per
// language; translations live beside them in one polymorphic table, keyed by
// (entity type, entity id, field, language).
//
// That shape is used in preference to per-model `title_it` / `title_ru` columns
// because the set of translatable fields changes far more often than the set of
// languages, and because a new translatable model then needs no migration at
// all — only an entry in the TRANSLATABLE registry in
// services/i18n/translatable.js.
//
// Referential integrity: `entityId` cannot be a foreign key when it points at
// six different tables, so orphans are swept by
// services/i18n/translationService.pruneOrphans() rather than by a cascade.
// That is the one trade-off of the polymorphic design and it is deliberate: the
// alternative (a nullable FK per model) grows a column for every new content
// type and still cannot express "any entity".

enum TranslationStatus {
  // Produced by the machine-translation provider and not reviewed by a human.
  MACHINE
  // A human has checked or corrected it. Never overwritten by a machine job.
  HUMAN_REVIEWED
  // The English source changed after this translation was made. Still readable,
  // but the API serves English instead until a fresh translation lands.
  OUTDATED
  // Every retry was exhausted. Recorded so the failure is visible and the API
  // can fall back to English without re-queueing forever.
  FAILED
}

enum TranslationJobStatus {
  QUEUED
  RUNNING
  DONE
  // Retryable failure: `runAfter` holds the backoff deadline.
  FAILED
  // Attempts exhausted. Needs an explicit admin retry.
  DEAD
}

// The current translation of one field of one record into one language.
model Translation {
  id            String            @id @default(uuid())
  entityType    String
  entityId      String
  field         String
  language      String
  value         String
  // sha256 of the exact English source this value was produced from. The API
  // compares it against the live source hash: a mismatch means outdated, which
  // is detected on read even if the job that should have marked it never ran.
  sourceHash    String
  // Monotonic per entity (see ContentVersion). A job carrying a LOWER version
  // than the stored row is dropped, so a slow job for old copy can never
  // overwrite a translation of newer copy (requirement §6.A.7).
  sourceVersion Int               @default(1)
  status        TranslationStatus @default(MACHINE)
  // "text" or "html" — decides whether the value is sanitised as markup and
  // whether the provider is asked for HTML-aware translation.
  format        String            @default("text")
  provider      String?
  providerModel String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // One current translation per field per language — this is what makes a
  // duplicate row impossible and lets the writer be a single upsert.
  @@unique([entityType, entityId, field, language])
  @@index([entityType, entityId])
  @@index([status])
  @@map("translations")
}

// A unit of pending translation work.
//
// Deliberately a table and not Redis/BullMQ: the queue depth here is a handful
// of rows per admin save, the worker is the API process itself, and adding a
// Redis dependency for that would be infrastructure this project does not need
// (requirement §6, and the project's own deployment constraints).
model TranslationJob {
  id            String               @id @default(uuid())
  entityType    String
  entityId      String
  field         String
  language      String
  sourceText    String
  sourceHash    String
  sourceVersion Int                  @default(1)
  format        String               @default("text")
  status        TranslationJobStatus @default(QUEUED)
  attempts      Int                  @default(0)
  maxAttempts   Int                  @default(5)
  lastError     String?
  // Backoff deadline. The worker only claims rows whose runAfter has passed.
  runAfter      DateTime             @default(now())
  // Claim stamp. A row RUNNING for longer than the stale timeout is reclaimed,
  // so a process killed mid-job does not strand its work.
  lockedAt      DateTime?
  lockedBy      String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  // Concurrent requests to translate the same content into the same language
  // collapse onto one row (requirement §6.A.12). The hash is part of the key so
  // edited copy still enqueues fresh work.
  @@unique([entityType, entityId, field, language, sourceHash])
  @@index([status, runAfter])
  @@map("translation_jobs")
}

// The English source version of one record.
//
// Exists so no business model needs a `version` column: `version` increments
// whenever any translatable field of that record changes, and `fieldHashes`
// records the hash each field had at that point, which is how "which fields
// actually changed on this save" is answered without diffing the old row.
model ContentVersion {
  entityType  String
  entityId    String
  version     Int      @default(1)
  fieldHashes Json     @default("{}")
  updatedAt   DateTime @updatedAt

  @@id([entityType, entityId])
  @@map("content_versions")
}

/// One machine caller's credential for the read-only API (services/apiKeys.js).
///
/// The key itself is NOT in this table and cannot be recovered from it: only a
/// SHA-256 digest is stored, and the plaintext is returned exactly once, by the
/// request that created it. `keyPrefix` is the first few characters, kept so a
/// key can be named and recognised in the panel without being readable.
model ApiKey {
  id        String   @id @default(uuid())
  /// What this key is for - "Marketing site poller". What you revoke by.
  name      String
  /// SHA-256 of the full key. Unique, so a presented key is one indexed lookup.
  keyHash   String   @unique
  /// First 16 characters, e.g. "tbc_live_8Fk2Qa" - for display only.
  keyPrefix String
  /// events:read, events:counts, events:sensitive. Deny by default: a scope
  /// that is not listed here is refused.
  scopes    String[]

  createdById String?
  /// Throttled to one write a minute, so a busy key is not a write per request.
  lastUsedAt  DateTime?
  lastUsedIp  String?

  /// Null means it never expires, which is a deliberate choice rather than a
  /// default - the create endpoint fills in a date unless told not to.
  expiresAt DateTime?

  /// Revocation is a timestamp, not a delete: the row is the record of what
  /// this key could reach and when it stopped working.
  revokedAt     DateTime?
  revokedById   String?
  /// Set on the new key of a rotation, pointing at the one it replaced.
  rotatedFromId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User? @relation("ApiKeysCreated", fields: [createdById], references: [id], onDelete: SetNull)
  revokedBy User? @relation("ApiKeysRevoked", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([revokedAt])
  @@map("api_keys")
}

// ─── TRAFFIC ANALYTICS ────────────────────────────────────────────────────────

// One browsing session: a visitor's tab from first page view until it goes
// quiet. Anonymous and signed-in sessions share the table; `userId` is filled
// the moment a valid session token accompanies a beat, which is how a guest
// who then logs in becomes one row with both halves of their visit.
// "Live" is derived (lastSeenAt within the heartbeat window), never stored.
model AnalyticsSession {
  id          String    @id
  visitorId   String
  userId      String?
  ip          String?
  country     String?
  city        String?
  device      String?
  browser     String?
  os          String?
  source      String?
  referrer    String?
  landingPath String
  currentPath String
  pageViews   Int       @default(1)
  loggedInAt  DateTime?
  startedAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  endedAt     DateTime?

  user   User?             @relation("AnalyticsSessionUser", fields: [userId], references: [id], onDelete: SetNull)
  events AnalyticsEvent[]

  @@index([lastSeenAt])
  @@index([startedAt])
  @@index([visitorId, startedAt])
  @@index([userId, startedAt])
  @@index([country])
  @@map("analytics_sessions")
}

// Append-only history. `type` is a free string (PAGE_VIEW, LOGIN_SUCCESS,
// LOGIN_FAILED, LOGOUT, REGISTER) so a new kind needs no migration. The
// denormalised `email` keeps a failed login readable: there is no user row to
// join for an address that does not exist.
model AnalyticsEvent {
  id        String   @id @default(uuid())
  type      String
  sessionId String?
  visitorId String?
  userId    String?
  email     String?
  path      String?
  ip        String?
  country   String?
  city      String?
  device    String?
  browser   String?
  createdAt DateTime @default(now())

  session AnalyticsSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User?             @relation("AnalyticsEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@map("analytics_events")
}
